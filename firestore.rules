rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to fetch user profile data
    function getStaffData() {
      return get(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)).data;
    }

    // Helper to determine if the user is an admin or is the bootstrapped root administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'warawaraconstructionkoinadugu@gmail.com' ||
        (exists(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Products Rules
    match /products/{productId} {
      allow read: if request.auth != null; // Searchable Price List access for everyone logged in
      allow create, delete: if isAdmin();
      allow update: if request.auth != null && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)) && 
         getStaffData().permissions.can_update_stock == true && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unit_price']))
      ); // Staff can update stock but are BLOCKED from modifying unit prices
    }

    // Staff Profiles Rules
    match /staff_profiles/{userId} {
      allow read: if request.auth != null;
      // Admin can execute write, and the bootstrapped root admin email can write their own profile
      allow write: if request.auth != null && (
        isAdmin() || 
        (userId == request.auth.uid && request.auth.token.email == 'warawaraconstructionkoinadugu@gmail.com')
      );
    }

    // Sales Ledger Rules
    match /sales_ledger/{saleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)) && 
         getStaffData().permissions.can_process_sales == true)
      );
      allow update, delete: if false; // Sales records cannot be tampered with once saved
    }

    // TBC Registry Rules
    match /tbc_registry/{tbcId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)) && 
         getStaffData().permissions.can_process_sales == true)
      );
      allow delete: if false;
    }
  }
}
