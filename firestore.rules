rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read, write: if true;
    }

    // Products Rules
    match /products/{productId} {
      allow read, write: if true;
    }

    // Staff Profiles Rules
    match /staff_profiles/{userId} {
      allow read, write: if true;
    }

    // Sales Ledger Rules
    match /sales_ledger/{saleId} {
      allow read, write: if true;
    }

    // TBC Registry Rules
    match /tbc_registry/{tbcId} {
      allow read, write: if true;
    }

    // Credits Registry Rules
    match /credits_registry/{creditId} {
      allow read, write: if true;
    }

    // Goods Categories Rules
    match /goods_categories/{categoryId} {
      allow read, write: if true;
    }

    // Notifications Board Rules
    match /notifications/{alertId} {
      allow read, write: if true;
    }

    // Expenditures Rules
    match /expenditures/{expenditureId} {
      allow read, write: if true;
    }

    // Bank Deposits Rules
    match /bank_deposits/{depositId} {
      allow read, write: if true;
    }
  }
}
